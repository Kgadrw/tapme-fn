# =============================================================================
# tapme-fn (frontend) · pairs with tapme-bn/.env
# =============================================================================
# Dev flow:
#   1) Backend:  cd tapme-bn && npm run dev   → http://localhost:3001
#   2) Frontend: npm run dev                 → http://localhost:8080
#   Orders POST to /api/contact/order (Vite proxies /api → :3001)

# Leave empty in local dev so Vite proxy handles /api → http://localhost:3001
# In production set the public API origin, e.g. https://api.tapme.rw
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=

# Must match hosts allowed in tapme-bn CORS_ORIGIN
VITE_APP_PROTOCOL=http
VITE_MARKETING_HOST=localhost:8080
VITE_PUBLIC_PROFILE_HOST=me.localhost:8080
VITE_DASHBOARD_HOST=profile.localhost:8080
VITE_ADMIN_DASHBOARD_HOST=dash.localhost:8081

# Production example:
# VITE_API_URL=https://api.tapme.rw
# VITE_APP_PROTOCOL=https
# VITE_MARKETING_HOST=tapme.rw
# VITE_PUBLIC_PROFILE_HOST=me.tapme.rw
# VITE_DASHBOARD_HOST=profile.tapme.rw
# VITE_ADMIN_DASHBOARD_HOST=dash.tapme.rw
